@model WebApplication1.ViewModels.PetViewModel

<h2>Novo Pet</h2>

<form asp-action="Create" method="post">

    <div>
        <label>Nome</label>
        <input asp-for="Nome" class="form-control" />
    </div>

    <div>
        <label>Espécie</label>
        <input asp-for="Especie" class="form-control" />
    </div>

    <div>
        <label>Raça</label>
        <input asp-for="Raca" class="form-control" />
    </div>

    <div>
        <label>Cliente</label>
        <select asp-for="ClienteId"
                asp-items="Model.Clientes"
                class="form-control">
            <option value="">Selecione</option>
        </select>
    </div>

    <br />

    <button class="btn btn-primary">Salvar</button>
</form>